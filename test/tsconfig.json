{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Test files should not be compiled */
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "typeRoots": ["../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*"]
}
